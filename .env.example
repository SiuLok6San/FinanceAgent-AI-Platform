# Copy this file to .env and fill in your own values. .env is gitignored.

# Data APIs (free tiers are enough)
FRED_API_KEY=
FINNHUB_API_KEY=
TAVILY_API_KEY=

# LLM served through Ollama.
# Hosted Ollama API: LLM_API_BASE=https://ollama.com and set OLLAMA_API_KEY.
# Local Ollama:      LLM_API_BASE=http://localhost:11434, leave OLLAMA_API_KEY empty,
#                    and run `ollama pull <model>` first.
LLM_API_BASE=https://ollama.com
LLM_MODEL_NAME=gpt-oss:20b
OLLAMA_API_KEY=
